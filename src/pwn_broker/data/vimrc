set nocompatible
set encoding=utf-8
scriptencoding utf-8
let mapleader = ","

let s:dir = expand('<sfile>:p:h')
execute 'set runtimepath^=' . fnameescape(s:dir)

" notes hold pasted tool output, which must never be read as vim settings
set nomodeline
" nothing but the note itself is written into the box folder
set nobackup nowritebackup noswapfile

set nonumber
set backspace=indent,eol,start
set autoindent
set expandtab shiftwidth=4 softtabstop=4
set linebreak breakindent
set scrolloff=3
set ignorecase smartcase incsearch nohlsearch
set wildmenu
set laststatus=2
set statusline=\ %f\ %m%=%l:%c\
set belloff=all
set shortmess+=I
set noautoread
set updatetime=1000
set termguicolors

" each target's section is a fold between these two markers; folds nest
let g:pwn_fold_start = '##########@@@@@@@@@@'
let g:pwn_fold_end = '@@@@@@@@@@##########'
set foldenable
set foldmethod=marker
set foldmarker=##########@@@@@@@@@@,@@@@@@@@@@##########
set foldlevelstart=0
set foldtext=PwnFoldText()
set fillchars=vert:\|,fold:\ ,eob:~

" a closed fold shows the line below its start marker and nothing else
function! PwnFoldText() abort
  let l:text = getline(v:foldstart + 1)
  if l:text =~# '^\s*$' || trim(l:text) ==# g:pwn_fold_end
    return '(empty fold)'
  endif
  return l:text
endfunction

" F8: an empty open fold below the current line, cursor on its blank line in insert mode
function! s:NewFold(insert) abort
  let l:row = foldclosedend('.') == -1 ? line('.') : foldclosedend('.')
  " a fold marker inside the box would break it, so on a box line the fold goes below the box
  let l:box = s:BoxEnd()
  if l:row <= l:box
    let l:row = l:box
  endif
  call append(l:row, [g:pwn_fold_start, '', g:pwn_fold_end])
  call cursor(l:row + 2, 1)
  normal! zv
  if !a:insert
    startinsert
  endif
endfunction
nnoremap <silent> <F8> <Cmd>call <SID>NewFold(0)<CR>
inoremap <silent> <F8> <Cmd>call <SID>NewFold(1)<CR>

" ,t ,i ,c: put text after the cursor, as `a` would, without typing it: a password holding a key
" name or a control character goes in as it is
function! s:Insert(text) abort
  let l:text = substitute(a:text, '[\r\n]', '', 'g')
  let l:line = getline('.')
  let l:at = l:line ==# '' ? 0 : col('.') - 1 + len(matchstr(l:line[col('.') - 1 :], '^.'))
  call setline('.', strpart(l:line, 0, l:at) . l:text . strpart(l:line, l:at))
  call cursor(line('.'), l:at + len(l:text))
endfunction

" the first IP of the target whose section the cursor is in: its Target: line reads
" `name   ip, ip   hostnames   scope`; '' when there is none
function! s:TargetIp() abort
  let l:n = search('^Target: ', 'bcnW')
  if l:n == 0
    return ''
  endif
  let l:fields = split(substitute(getline(l:n), '^Target: ', '', ''), ' \{3}')
  if len(l:fields) < 2 || l:fields[1] ==# '-'
    return ''
  endif
  return trim(split(l:fields[1], ',')[0])
endfunction

function! s:InsertIp() abort
  let l:ip = s:TargetIp()
  if l:ip ==# ''
    echo 'no IP: the cursor is not in a section of a target that has one'
    return
  endif
  call s:Insert(l:ip)
endfunction

" every user:password and user:hash pair the app keeps in the box's lists/ folder
function! s:CredChoices() abort
  let l:folder = fnamemodify(argc() > 0 ? argv(0) : expand('%'), ':p:h') . '/lists/'
  let l:found = []
  for l:name in ['userpass.txt', 'userhash.txt']
    if filereadable(l:folder . l:name)
      let l:found += filter(readfile(l:folder . l:name), 'v:val !=# ""')
    endif
  endfor
  return l:found
endfunction

function! s:PickCred() abort
  let l:choices = s:CredChoices()
  if empty(l:choices)
    echo 'no credentials in the box yet'
    return
  endif
  let l:menu = ['credential to insert:'] + map(copy(l:choices), 'printf("%d  %s", v:key + 1, v:val)')
  let l:n = inputlist(l:menu)
  if l:n >= 1 && l:n <= len(l:choices)
    call s:Insert(l:choices[l:n - 1])
  endif
endfunction

nnoremap <silent> <Leader>t <Cmd>call <SID>Insert(strftime('%Y-%m-%d %H:%M'))<CR>
nnoremap <silent> <Leader>i <Cmd>call <SID>InsertIp()<CR>
nnoremap <silent> <Leader>c <Cmd>call <SID>PickCred()<CR>

" ,x: tick or untick the first checkbox on the line
function! s:ToggleBox() abort
  let l:line = getline('.')
  if l:line =~# '\[ \]'
    call setline('.', substitute(l:line, '\[ \]', '[x]', ''))
  elseif l:line =~# '\[x\]'
    call setline('.', substitute(l:line, '\[x\]', '[ ]', ''))
  else
    echo 'no [ ] or [x] on this line'
  endif
endfunction
nnoremap <silent> <Leader>x <Cmd>call <SID>ToggleBox()<CR>

" :Pb: read one of the box's playbooks into the note. The app lists the folders of the notes
" packages installed for the open box in run/notes, one per line.
function! s:NotesFile() abort
  return get(g:, 'pwn_notes_file', fnamemodify(s:dir, ':h') . '/run/notes')
endfunction

" every playbook installed for the box, sorted by its path under its folder: its name (the file
" name without .md), that path, the file, and the package it came from
function! s:Playbooks() abort
  let l:list = s:NotesFile()
  if !filereadable(l:list)
    return []
  endif
  let l:found = []
  for l:root in readfile(l:list)
    if l:root ==# '' || !isdirectory(l:root)
      continue
    endif
    let l:base = substitute(l:root, '/\+$', '', '') . '/'
    let l:package = matchstr(l:root, '/tools/\zs[^/]\+\ze/')
    if l:package ==# ''
      let l:package = fnamemodify(substitute(l:root, '/\+$', '', ''), ':t')
    endif
    for l:file in globpath(l:root, '**/*.md', 0, 1)
      let l:file = substitute(l:file, '\\', '/', 'g')
      let l:rel = stridx(l:file, l:base) == 0 ? l:file[len(l:base) :] : fnamemodify(l:file, ':t')
      let l:rel = fnamemodify(l:rel, ':r')
      call add(l:found, {'name': fnamemodify(l:rel, ':t'), 'rel': l:rel, 'file': l:file, 'package': l:package})
    endfor
  endfor
  return sort(l:found, {a, b -> a.rel ==# b.rel ? 0 : a.rel ># b.rel ? 1 : -1})
endfunction

" Tab on :Pb: the names holding what was typed, in any case
function! PwnPbComplete(arglead, cmdline, pos) abort
  let l:names = map(s:Playbooks(), 'v:val.name')
  call filter(l:names, 'stridx(tolower(v:val), tolower(a:arglead)) >= 0')
  return uniq(sort(l:names))
endfunction

function! s:PickPlaybook(title, items, with_package) abort
  let l:menu = [a:title]
  for l:i in range(len(a:items))
    let l:item = a:items[l:i]
    call add(l:menu, printf('%d  %s', l:i + 1, (a:with_package ? l:item.package . '/' : '') . l:item.rel))
  endfor
  let l:n = inputlist(l:menu)
  return l:n >= 1 && l:n <= len(a:items) ? a:items[l:n - 1] : {}
endfunction

" below the cursor, or below the closed fold it is on, and never inside the box; the new fold is
" left open with the cursor on its run block's first line
function! s:ReadPlaybook(file) abort
  let l:row = foldclosedend('.') == -1 ? line('.') : foldclosedend('.')
  let l:box = s:BoxEnd()
  if l:row <= l:box
    let l:row = l:box
  endif
  execute l:row . 'read ' . fnameescape(a:file)
  call cursor(l:row + 3, 1)
  normal! zv
endfunction

function! s:Pb(name) abort
  let l:all = s:Playbooks()
  if empty(l:all)
    echo 'no playbooks for this box: tool install playbooks at the prompt'
    return
  endif
  if a:name ==# ''
    let l:pick = s:PickPlaybook('playbook to read:', l:all, 0)
  else
    let l:matches = filter(copy(l:all), 'v:val.name ==# a:name')
    if empty(l:matches)
      echo 'no playbook named ' . a:name . '; :Pb on its own lists them'
      return
    endif
    let l:pick = len(l:matches) == 1 ? l:matches[0] : s:PickPlaybook('which playbook:', l:matches, 1)
  endif
  if !empty(l:pick)
    call s:ReadPlaybook(l:pick.file)
  endif
endfunction
command! -nargs=? -complete=customlist,PwnPbComplete Pb call <SID>Pb(<q-args>)

" ,h: what this vimrc adds to vim, and the fold keys the note is built around
function! s:HelpLines() abort
  return [
        \ ',h       this list',
        \ ',t       insert the date and time after the cursor',
        \ ',i       insert the IP of the target whose section the cursor is in',
        \ ',c       pick one of the box''s user:password or user:hash pairs to insert',
        \ ',x       tick or untick the first [ ] or [x] on this line',
        \ 'F8       new empty fold below the cursor, in normal or insert mode',
        \ ':Pb      read a playbook into the note below the cursor; Tab completes its name',
        \ 'za       open or close the fold under the cursor',
        \ 'zo  zc   open, close the fold under the cursor',
        \ 'zR  zM   open, close every fold',
        \ '',
        \ 'The note saves itself after a second without typing and when the',
        \ 'window loses focus; [+] in the status line means it has not yet.',
        \ 'When the app redraws the box at the top, the note reloads by',
        \ 'itself and the cursor and folds stay where they were.',
        \ ]
endfunction

" a typed key closes the list; vim's own events (an idle CursorHold, focus, the mouse moving) reach
" the filter too, as K_SPECIAL KS_EXTRA, and are passed on
function! s:HelpKey(id, key) abort
  if a:key[:1] ==# "\x80\xfd"
    return 0
  endif
  call popup_close(a:id)
  return 1
endfunction

function! s:Help() abort
  let l:lines = s:HelpLines()
  if !exists('*popup_create')
    echo join(l:lines, "\n")
    return
  endif
  call popup_create(l:lines + ['', 'any key closes this'], {
        \ 'title': ' note keys ', 'padding': [0, 1, 0, 1], 'border': [],
        \ 'highlight': 'Folded', 'borderhighlight': ['Comment'],
        \ 'mapping': 0, 'filter': function('s:HelpKey'),
        \ })
endfunction
nnoremap <silent> <Leader>h <Cmd>call <SID>Help()<CR>

" Defined before filetype detection is switched on, so it runs first and markdown is never set.
" Detection goes on before syntax: ":syntax on" would otherwise run detection on the note's
" buffer by itself, without this group.
augroup pwn_broker_filetype
  autocmd!
  autocmd BufNewFile,BufRead notes.md setfiletype pwnnote
augroup END
filetype on
syntax on
execute 'source ' . fnameescape(s:dir . '/nightshift.vim')

let s:state = ''
let s:dirty = -1
function! s:Mark(value) abort
  if s:state ==# ''
    let s:state = fnamemodify(argc() > 0 ? argv(0) : expand('%'), ':p:h') . '/.note-state'
  endif
  if s:dirty != a:value
    let s:dirty = a:value
    silent! call writefile([string(a:value)], s:state)
  endif
endfunction

" Reloading. 'autoread' is off so that every change on disk goes through FileChangedShell: when
" the buffer has no unsaved changes the note is reloaded there, and the cursor and folds are saved
" just before and put back just after. With unsaved changes Vim asks, as it always has.
let s:rule = '^#\{20,}[[:space:]]*$'
let s:saved = {}

" the last line of the box, 0 when the note does not start with a whole one: the closing rule has
" as many # as the opening one, every line between starts with # and holds no fold marker
function! s:BoxEnd() abort
  let l:first = getline(1)
  if l:first !~# s:rule
    return 0
  endif
  let l:width = len(matchstr(l:first, '^#*'))
  let l:last = line('$')
  let l:n = 2
  while l:n <= l:last
    let l:line = getline(l:n)
    if l:line !~# '^#' || stridx(l:line, g:pwn_fold_start) >= 0
      return 0
    endif
    if l:line =~# s:rule && len(matchstr(l:line, '^#*')) == l:width
      return l:n
    endif
    let l:n += 1
  endwhile
  return 0
endfunction

function! s:FoldStarts() abort
  let l:view = winsaveview()
  let l:starts = []
  call cursor(1, 1)
  while 1
    let l:n = search('\V' . g:pwn_fold_start, 'cW')
    if l:n == 0
      break
    endif
    call add(l:starts, l:n)
    if l:n >= line('$')
      break
    endif
    call cursor(l:n + 1, 1)
  endwhile
  call winrestview(l:view)
  return l:starts
endfunction

" 1 for an open fold and 0 for a closed one, in the order the folds start. A fold inside a closed
" fold cannot be seen, so a closed fold holding others is opened to look and closed again.
function! s:FoldStates(starts) abort
  let l:states = []
  let l:opened = []
  for l:i in range(len(a:starts))
    let l:n = a:starts[l:i]
    let l:closed = foldclosed(l:n)
    call add(l:states, l:closed == -1)
    if l:closed == l:n && l:i + 1 < len(a:starts) && a:starts[l:i + 1] <= foldclosedend(l:n)
      execute l:n . 'foldopen'
      call add(l:opened, l:n)
    endif
  endfor
  for l:n in reverse(l:opened)
    execute l:n . 'foldclose'
  endfor
  return l:states
endfunction

function! s:Snapshot() abort
  let l:view = winsaveview()
  let s:saved = {'buf': bufnr('%'), 'view': l:view, 'box': s:BoxEnd(), 'folds': s:FoldStates(s:FoldStarts())}
  call winrestview(l:view)
endfunction

function! s:Changed() abort
  if v:fcs_reason ==# 'changed'
    let s:saved = {}
    if str2nr(expand('<abuf>')) == bufnr('%')
      call s:Snapshot()
    endif
    let v:fcs_choice = 'reload'
  elseif v:fcs_reason ==# 'conflict'
    let v:fcs_choice = 'ask'
  endif
endfunction

function! s:Restore() abort
  if empty(s:saved) || bufnr('%') != s:saved.buf
    return
  endif
  let l:saved = s:saved
  let s:saved = {}
  " folds by position; a fold that was not there before, such as a new target's, starts closed
  let l:starts = s:FoldStarts()
  silent! %foldopen!
  for l:i in reverse(range(len(l:starts)))
    if l:i >= len(l:saved.folds) || !l:saved.folds[l:i]
      silent! execute l:starts[l:i] . 'foldclose'
    endif
  endfor
  " the box is the part the app redraws: lines in it keep their number, lines below it move with
  " its end, and anything added further down moves nothing above it
  let l:delta = s:BoxEnd() - l:saved.box
  let l:view = copy(l:saved.view)
  for l:key in ['lnum', 'topline']
    if l:view[l:key] > l:saved.box
      let l:view[l:key] += l:delta
    endif
    let l:view[l:key] = max([1, min([l:view[l:key], line('$')])])
  endfor
  call winrestview(l:view)
endfunction

function! s:Check() abort
  silent! checktime
endfunction

" the timer leaves the note alone while I am partway through something: a mapping, a count or an
" operator, insert-mode completion, a selection or a command line
function! s:Busy() abort
  return state('moa') !=# '' || mode(1) =~# '^[vVsSc]' || mode(1) =~# "^[\<C-v>\<C-s>]"
endfunction

function! s:Reload(timer) abort
  if !s:Busy()
    call s:Check()
  endif
endfunction

augroup pwn_broker
  autocmd!
  autocmd TextChanged,TextChangedI notes.md call s:Mark(1)
  autocmd BufWritePost notes.md call s:Mark(0)
  " ++nested: a command run by an autocommand sets off no autocommands of its own unless asked to,
  " and this save has to run BufWritePost below, or the mark would go on saying "unsaved"
  autocmd FocusLost,CursorHold,CursorHoldI * ++nested silent! update
  autocmd FocusGained * silent! checktime
  autocmd FileChangedShell notes.md call s:Changed()
  autocmd FileChangedShellPost notes.md call s:Restore()
  autocmd VimEnter * call s:Mark(0)
  autocmd VimLeave * if s:state !=# '' | silent! call delete(s:state) | endif
augroup END

if has('timers')
  call timer_start(1000, function('s:Reload'), {'repeat': -1})
endif
